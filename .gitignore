# ---------------------------------------------------------------------------
# Data. Raw and intermediate data are large and fully reproducible by running
# `make data`, so they are never committed. Processed feature tables are also
# regenerated. The test suite needs none of this: it builds its own small
# synthetic frames in tests/conftest.py.
# ---------------------------------------------------------------------------
data/raw/
data/interim/
data/processed/
data/runs/

# ---------------------------------------------------------------------------
# Secrets. MBTA_API_KEY lives in .env, which must never be committed.
# ---------------------------------------------------------------------------
.env

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
build/
dist/
.pytest_cache/
.ipynb_checkpoints/

# ---------------------------------------------------------------------------
# OS / editor / tooling
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
.reasonix/
.claude/
